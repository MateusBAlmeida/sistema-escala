{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite",
            "outputDirectory": "dist"
        },
        "backend": {
            "root": "backend",
            "entrypoint": "src/app.js"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/backend/src/app.js"
        },
        {
            "source": "/(.*)",
            "destination": "/backend/src/app.js"
        }
    ]
}