{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "outputDirectory": "dist"
    },

    "backend": {
      "root": "backend",
      "entrypoint": "src/app.js"
    }
  },

  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/ferias",
      "destination": {
        "service": "frontend",
        "path": "/pages/ferias"
      }
    }
  ]
}